# ESP-SR model selection: offline wake "Computer" + English MultiNet 6.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_MODEL_IN_FLASH=y
CONFIG_SR_WN_WN9_COMPUTER_TTS=y
CONFIG_SR_MN_EN_MULTINET6_QUANT=y
CONFIG_SPIRAM=y
CONFIG_ESP32S3_SPIRAM_SUPPORT=y
CONFIG_ESP32_SPIRAM_SUPPORT=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000

# Required for hybrid Arduino+ESP-IDF: Arduino owns the firmware entry point.
CONFIG_AUTOSTART_ARDUINO=y
# Required by Arduino NetworkClientSecure (HTTPS radio streams).
# Without these, ssl_client.cpp compiles out its implementation and linking fails.
CONFIG_MBEDTLS_PSK_MODES=y
CONFIG_MBEDTLS_KEY_EXCHANGE_PSK=y

# Workaround: GCC ICE in esp_lcd_panel_rgb.c during RTL IRA pass on Windows.
# Reported workaround is Optimize for size (-Os).
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
